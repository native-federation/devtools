{
  "name": "native-federation-devtools",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:extension": "node scripts/build-extension.mjs",
    "check:panel-bundle": "node scripts/check-panel-bundle.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test devtools-ui && ng test devtools-bridge && npm run test:collector && npm run test:guards",
    "test:collector": "tsc -p projects/collector/tsconfig.lib.json && vitest run --config vitest.collector.config.mts",
    "test:guards": "vitest run --config vitest.guards.config.mts"
  },
  "private": true,
  "license": "MIT",
  "packageManager": "npm@11.8.0",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "rxjs": "~7.8.0",
    "semver": "^7.8.5",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.9",
    "@angular/cli": "^22.0.9",
    "@angular/compiler-cli": "^22.0.0",
    "@types/semver": "^7.8.0",
    "jsdom": "^28.0.0",
    "ng-packagr": "^22.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
