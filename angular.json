{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "devtools-ui": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/devtools-ui",
      "sourceRoot": "projects/devtools-ui/src",
      "prefix": "nf",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/devtools-ui/src/main.ts",
            "tsConfig": "projects/devtools-ui/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/devtools-ui/public"
              }
            ],
            "styles": ["projects/devtools-ui/src/styles.css"],
            "allowedCommonJsDependencies": ["semver"]
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "projects/devtools-ui/src/environments/environment.ts",
                  "with": "projects/devtools-ui/src/environments/environment.extension.ts"
                }
              ],
              "optimization": {
                "scripts": true,
                "fonts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                }
              },
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "devtools-ui:build:production"
            },
            "development": {
              "buildTarget": "devtools-ui:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    },
    "devtools-bridge": {
      "projectType": "library",
      "root": "projects/devtools-bridge",
      "sourceRoot": "projects/devtools-bridge/src",
      "prefix": "nf",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/devtools-bridge/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/devtools-bridge/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/devtools-bridge/tsconfig.spec.json"
          }
        }
      }
    }
  }
}
